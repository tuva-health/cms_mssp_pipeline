# Credentials and state — never commit
config.txt
state.json

# Downloaded/extracted source files
downloads/
reference/

# Processing staging directory
STAGED/

# Pipeline run manifests
.runs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/
.pytest_cache/

# uv
.uv/
# uv.lock is committed on purpose: the image builds `uv sync --frozen` from it,
# so a clean checkout reproduces the same dependency set.

# Environment
.env
.envrc.local

# Client deployment overlays (keep only examples in git)
infra/clients/*
!infra/clients/client.example/
!infra/clients/client.example/**

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Editor
.DS_Store
.idea/
.vscode/
.claude/*
!.claude/CLAUDE.md

# Binaries — large CMS-provided executables
# Track explicit files to avoid accidentally committing other binaries
bin/*
!bin/acoms-cli
!bin/acoms-cli-linux
