#!/usr/bin/env bash
# Client-local deploy settings (do not commit real values)

# AWS context
export AWS_PROFILE=your-aws-profile
export AWS_REGION=us-east-1

# Optional override (if not set, deploy script resolves via STS)
# export ACCOUNT_ID=<aws-account-id>

# Optional project name override (must match foundation.tfvars project_name)
# export PROJECT_NAME=mssp-pipeline

# Container/image. Deployments use an immutable digest, never a mutable tag.
# This is the repository@sha256 value written to release-metadata/<id>.json by
# scripts/build-and-push-image.sh. Keep it an overridable default so
# scripts/deploy-and-smoke-client.sh / run-client-process-task.sh can pass the
# digest of a release they just built through to deploy-client.sh.
export PIPELINE_IMAGE="${PIPELINE_IMAGE:-<account>.dkr.ecr.us-east-1.amazonaws.com/mssp-pipeline@sha256:<64-hex-digest>}"

# Backend bootstrap approval. The one-time remote-state bootstrap requires the
# operator to pass MSSP_APPROVE_BACKEND_BOOTSTRAP equal to this phrase.
# export BACKEND_BOOTSTRAP_APPROVAL="<your-explicit-approval-phrase>"

# Runtime output backend
export MSSP_OUTPUT_TYPE=PARQUET
# Optional override; defaults to s3://$FILE_STORE_BUCKET/$OUTPUT_PREFIX when unset.
# export MSSP_OUTPUT_LOCATION=s3://my-mssp-bucket/processed/output
# Optional override; defaults to /tmp/mssp-staging when unset.
# export MSSP_TEMP_LOCATION=/tmp/mssp-staging

# ECS taskdef render values
export ACO_ID=A1234
export FILE_STORE_BUCKET=my-mssp-bucket
# Optional prefixes. Leave empty to use bucket root (s3://<bucket>)
export FILE_STORE_PREFIX=raw/input
export OUTPUT_PREFIX=processed/output

# Snowflake-only runtime settings (required when MSSP_OUTPUT_TYPE=SNOWFLAKE)
# export SNOWFLAKE_USERNAME=svc_mssp
# export SNOWFLAKE_ACCOUNT=acme-org.us-east-1
# export SNOWFLAKE_DATABASE=MSSP
# export SNOWFLAKE_SCHEMA=RAW_DATA
# export SNOWFLAKE_COMPUTE_WAREHOUSE=COMPUTE_WH
# export SNOWFLAKE_ACCOUNT_ROLE=ACCOUNTADMIN
# Secret should contain the Snowflake private key PEM. Raw PEM text is supported;
# base64-encoded PEM also works and will be auto-detected by the entrypoint.
# export SNOWFLAKE_RSA_KEY_SECRET_ID=mssp/snowflake/rsa-key
# export SNOWFLAKE_RSA_KEY_PASSPHRASE_SECRET_ID=mssp/snowflake/rsa-key-passphrase

# Optional for bootstrap task prompt automation
export NAT_EIP_OR_EMPTY=

# Readiness gate SSM parameters, injected into the readiness-gates container as
# ECS secrets via <READINESS_<GATE>_PARAM_ARN> (derived from REGION + ACCOUNT_ID
# + the parameter name). Defaults are the foundation-created parameters; set
# READINESS_<GATE>_PARAM only to rename one or add a gate.
# export READINESS_BOOTSTRAP_PARAM=/mssp/bootstrap_complete
# export READINESS_WHITELIST_PARAM=/mssp/whitelist_confirmed
