region       = "us-east-1"
project_name = "mssp-pipeline"

# Optional overrides
# vpc_cidr = "10.42.0.0/16"
# tags = {
#   Environment = "dev"
#   Owner       = "data-platform"
# }

# Optional: have foundation create placeholder Secrets Manager secrets for
# Snowflake runtime auth so ECS task execution can inject them. Store the
# private key secret value as base64-encoded PEM content for ECS injection.
# snowflake_rsa_key_secret_name = "mssp/snowflake/rsa-key"
# snowflake_rsa_key_passphrase_secret_name = "mssp/snowflake/rsa-key-passphrase"

# Buckets the runtime task role may list, read and write. Scope this to the
# file store. Required: terraform will not plan without it.
runtime_s3_resource_arns = [
  "arn:aws:s3:::<MSSP_BUCKET>",
  "arn:aws:s3:::<MSSP_BUCKET>/*",
]

# Optional: per-stage ECS task execution roles provisioned outside this module
# whose task definitions inject the readiness gates (/mssp/bootstrap_complete,
# /mssp/whitelist_confirmed) as container secrets. Each listed role is granted
# ssm:GetParameters on exactly those two parameters. The roles are attached by
# name and must exist before this module is applied.
# readiness_execution_role_names = [
#   "mssp-pipeline-download-execution-role",
#   "mssp-pipeline-snowflake-execution-role",
# ]
