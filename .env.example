# Copy this file to .env and fill in your values.
# .env is gitignored — never commit credentials.

# Shared
MSSP_ACO_ID=
MSSP_FILE_STORE=

# Processing output
# Options: PARQUET, DUCKDB, MOTHERDUCK, SNOWFLAKE, DATABRICKS, BIGQUERY, REDSHIFT, FABRIC
MSSP_OUTPUT_TYPE=SNOWFLAKE
MSSP_OUTPUT_LOCATION=~/.data/mssp.duckdb

# Snowflake (required when MSSP_OUTPUT_TYPE=SNOWFLAKE)
SNOWFLAKE_USERNAME=
SNOWFLAKE_DATABASE=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_RSA_KEY_PATH=~/.ssh/snowflake_rsa_key.p8
SNOWFLAKE_RSA_KEY_PASSPHRASE=

# AWS (required when MSSP_FILE_STORE is s3://)
# Use AWS_PROFILE (recommended) or AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY
AWS_PROFILE=
AWS_REGION=us-east-1

# Optional: S3 bucket for download state and file storage.
# Defaults to the bucket inferred from MSSP_FILE_STORE when that is an s3:// URL.
# Set only if you need to use a different bucket for downloads vs. the file store.
MSSP_S3_BUCKET=
