# Copy this file to .env.tier1-private and fill in your Tier 1 values.
# .env.tier1-private is gitignored. Do not commit AWS credentials or PHI paths
# that should not be shared.

# Required
MSSP_ACO_ID=
MSSP_START_YEAR=2025
MSSP_FILE_STORE=s3://your-private-claims-bucket/tier1/private-claims

# Download behavior
MSSP_DOWNLOAD_MODE=incremental

# Processing output
# For a private S3 source, PARQUET is the lightest local verification output.
# Change this to SNOWFLAKE, DATABRICKS, BIGQUERY, REDSHIFT, or FABRIC when needed.
MSSP_OUTPUT_TYPE=PARQUET
MSSP_OUTPUT_LOCATION=~/.data/mssp-tier1-private
MSSP_FULL_REFRESH=false
MSSP_TEMP_LOCATION=./STAGED

# AWS auth. Prefer AWS_PROFILE or IAM role. Only use access keys via your local,
# gitignored .env.tier1-private file if there is no safer option.
AWS_PROFILE=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
