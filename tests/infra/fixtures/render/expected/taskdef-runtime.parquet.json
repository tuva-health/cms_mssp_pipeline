{
  "family": "mssp-pipeline-runtime",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "4096",
  "memory": "30720",
  "ephemeralStorage": {
    "sizeInGiB": 100
  },
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::111122223333:role/mssp-pipeline-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::111122223333:role/mssp-pipeline-runtime-task-role",
  "containerDefinitions": [
    {
      "name": "readiness-gates",
      "image": "111122223333.dkr.ecr.us-east-1.amazonaws.com/mssp-pipeline@sha256:1111111111111111111111111111111111111111111111111111111111111111",
      "essential": false,
      "command": [
        "python",
        "-m",
        "mssp_pipeline.readiness",
        "bootstrap",
        "whitelist"
      ],
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        }
      ],
      "secrets": [
        {
          "name": "MSSP_READINESS_BOOTSTRAP",
          "valueFrom": "arn:aws:ssm:us-east-1:111122223333:parameter/mssp/bootstrap_complete"
        },
        {
          "name": "MSSP_READINESS_WHITELIST",
          "valueFrom": "arn:aws:ssm:us-east-1:111122223333:parameter/mssp/whitelist_confirmed"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mssp-pipeline",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "readiness"
        }
      }
    },
    {
      "name": "mssp-runtime",
      "image": "111122223333.dkr.ecr.us-east-1.amazonaws.com/mssp-pipeline@sha256:1111111111111111111111111111111111111111111111111111111111111111",
      "essential": true,
      "command": [
        "mssp-pipeline"
      ],
      "dependsOn": [
        {
          "containerName": "readiness-gates",
          "condition": "SUCCESS"
        }
      ],
      "environment": [
        {
          "name": "MSSP_WORKDIR",
          "value": "/app"
        },
        {
          "name": "MSSP_WRITE_CONFIG_TXT",
          "value": "auto"
        },
        {
          "name": "MSSP_CLI_PATH",
          "value": "/app/bin/acoms-cli"
        },
        {
          "name": "MSSP_ACO_ID",
          "value": "A9999"
        },
        {
          "name": "MSSP_FILE_STORE",
          "value": "s3://example-mssp-bucket/raw/input"
        },
        {
          "name": "MSSP_OUTPUT_TYPE",
          "value": "PARQUET"
        },
        {
          "name": "MSSP_OUTPUT_LOCATION",
          "value": "s3://example-mssp-bucket/processed/output"
        },
        {
          "name": "MSSP_TEMP_LOCATION",
          "value": "/tmp/mssp-staging"
        },
        {
          "name": "MSSP_DOWNLOAD_MODE",
          "value": "incremental"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        }
      ],
      "secrets": [
        {
          "name": "ACOMS_CONFIG_TXT",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:111122223333:secret:mssp/acoms-config-AAAAAA"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mssp-pipeline",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "runtime"
        }
      }
    }
  ]
}
